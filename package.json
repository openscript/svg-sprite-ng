{
  "name": "svg-sprite",
  "version": "3.0.0-rc3",
  "description": "SVG sprites & stacks galore — A low-level Node.js module that takes a bunch of SVG files, optimizes them and bakes them into SVG sprites of several types along with suitable stylesheet resources (e.g. CSS, Sass, LESS, Stylus, etc.)",
  "keywords": [
    "css",
    "generator",
    "gulpfriendly",
    "html",
    "icon",
    "icons",
    "inline",
    "less",
    "mustache",
    "png",
    "retina",
    "rwd",
    "sass",
    "sprite",
    "spritesheet",
    "stack",
    "stylesheet",
    "stylus",
    "svg",
    "vector"
  ],
  "homepage": "https://github.com/svg-sprite/svg-sprite",
  "bugs": {
    "url": "https://github.com/svg-sprite/svg-sprite/issues"
  },
  "license": "MIT",
  "author": "Joschi Kuphal <joschi@kuphal.net> (https://jkphl.is)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svg-sprite/svg-sprite.git"
  },
  "bin": {
    "svg-sprite": "./dist/cli.js"
  },
  "files": [
    "dist",
    "tmpl"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "example": "node --experimental-strip-types example.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "css-selector-parser": "^1.4.1",
    "csso": "^5.0.5",
    "cssom": "^0.5.0",
    "js-yaml": "^5.4.2",
    "mustache": "^4.2.0",
    "svgo": "^4.1.0",
    "tinyglobby": "^0.2.17",
    "xpath": "^0.0.34",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/csso": "^5.0.5",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.12.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.2",
    "less": "^4.4.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pixelmatch": "^7.2.0",
    "playwright-chromium": "^1.50.1",
    "pngjs": "^7.0.0",
    "sass": "^1.91.0",
    "stylus": "^0.64.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
